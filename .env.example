# Local Docker database (compose binds only to loopback).
DATABASE_URL="postgres://root:mysecretpassword@127.0.0.1:6000/local"

# Use the same origin at build and runtime. Public deployments require HTTPS.
APP_ORIGIN="http://localhost:5173"

# Generate with bun run auth:key and paste here. Never use a checked-in test key.
AUTH_ENCRYPTION_KEY=""

# Public verified signup; existing firms require explicit invitations.
SIGNUP_MODE="public"
# MFA is mandatory on public deployments; true also exercises it locally.
REQUIRE_MFA="false"

# preview: the app writes emails to .local/mail instead of sending them (local only).
MAIL_MODE="preview"
# Production: MAIL_MODE="resend", verified sender and private API key.
# RESEND_API_KEY=""
# MAIL_FROM="Lines <accounts@your-verified-domain>"

# Disposable database only (name must end in _test). Integration tests truncate it and
# create/drop temporary databases and roles, so the test user needs CREATEDB and CREATEROLE.
# TEST_DATABASE_URL="postgres://root:mysecretpassword@127.0.0.1:6000/lines_test"

# File storage for documents (S3-compatible). These match the local MinIO in compose.yaml.
# Production: Cloudflare R2 (S3_REGION="auto"). Without these, documents are turned off.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_BUCKET="lines-dev"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="lines"
S3_SECRET_ACCESS_KEY="lines-local-secret"

# Optional. Companies House API key for looking up companies (developer.company-information.service.gov.uk).
COMPANIES_HOUSE_API_KEY=""
COMPANIES_HOUSE_API_TEST_KEY=""
