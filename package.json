{
	"name": "riality",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"start": "bun ./build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "bun run test:components --run && bun run test:integration && bun run test:e2e",
		"test:components": "vitest",
		"test:integration": "bun test tests/integration",
		"test:e2e": "playwright test",
		"db:start": "docker compose up",
		"db:generate": "drizzle-kit generate",
		"db:check": "drizzle-kit check",
		"db:migrate": "drizzle-kit migrate",
		"db:reset": "bun scripts/reset-db.ts",
		"db:seed": "bun scripts/seed-db.ts",
		"db:studio": "drizzle-kit studio",
		"db:grant-runtime": "bun scripts/grant-runtime.ts",
		"auth:key": "bun -e \"console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))\"",
		"auth:provision": "bun scripts/provision-user.ts",
		"auth:disable": "bun scripts/disable-user.ts",
		"auth:reset-mfa": "bun scripts/reset-mfa.ts",
		"auth:rotate-key": "bun scripts/rotate-auth-key.ts",
		"tenancy:create-group": "bun scripts/create-group.ts",
		"tenancy:move": "bun scripts/move-tenant.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/bun": "^1.4.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#server/*": "./src/server/*"
	},
	"dependencies": {
		"zod": "^4"
	},
	"overrides": {
		"esbuild": "0.28.2"
	}
}
